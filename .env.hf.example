# ══════════════════════════════════════════════════════════════════════════════
#  .env.hf.example — Variables d'environnement pour HuggingFace Spaces
#
#  À configurer dans : HF Space → Settings → Variables and Secrets
#  (Les secrets sont chiffrés et non visibles après enregistrement)
#
#  NE PAS committer ce fichier avec de vraies valeurs !
# ══════════════════════════════════════════════════════════════════════════════

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Utilise l'API Mistral (gratuit : 1 milliard de tokens/mois)
# Créer un compte sur https://console.mistral.ai → API Keys
LLM_PROVIDER=mistral_api
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=mistral-small-latest

# ── Vector Store (Qdrant local — pré-configuré dans le Dockerfile) ───────────
# Ne pas modifier : déjà défini dans le Dockerfile
QDRANT_LOCAL_PATH=/app/qdrant_data

# ── Cache (Redis non disponible sur le free tier — fallback mémoire auto) ─────
# Laisser la valeur par défaut ; le fallback mémoire s'active automatiquement
REDIS_URL=redis://localhost:6379/0

# ── CORS ─────────────────────────────────────────────────────────────────────
# Autoriser toutes les origines (les appels API passent via le proxy Next.js)
ALLOWED_ORIGINS=["*"]

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=UNICEF Advisory Chatbot
DEBUG=false
